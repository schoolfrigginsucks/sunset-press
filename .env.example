# ---------------------------------------------------------------
# Sunset Press — Shopify Storefront API credentials
# Copy this file to `.env` and fill in the two values below.
# `.env` is gitignored. These are PUBLIC-safe values (see README).
# ---------------------------------------------------------------

# Your permanent myshopify.com domain — NOT your custom domain.
# Shopify admin → Settings → Domains → look for the ".myshopify.com" one.
VITE_SHOPIFY_STORE_DOMAIN=lunarest-store.myshopify.com

# Storefront API access token (public token, safe to ship in a browser bundle).
# Shopify admin → Settings → Apps and sales channels → Develop apps
#   → Create an app → Configuration → Storefront API → Configure
#   → tick: unauthenticated_read_product_listings,
#           unauthenticated_read_product_inventory,
#           unauthenticated_write_checkouts,
#           unauthenticated_read_checkouts
#   → Save → API credentials tab → Install app
#   → copy "Storefront API access token"
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Optional — Storefront API version. Bump when Shopify deprecates this one.
VITE_SHOPIFY_API_VERSION=2025-10
